# ═══════════════════════════════════════════════════════════════════
# Brewfile.optional — on-demand extras, NOT installed by the pipeline.
# Ask the user during setup; install only what this machine's role needs.
# ═══════════════════════════════════════════════════════════════════

cask "gcloud-cli"                # only for machines doing GCP work
brew "stripe/stripe-cli/stripe"  # only for payments development
# Recoverable Claude Code sessions + menubar app. Install with `pipeline.sh --with cc-moss`,
# which also runs `cc-moss install --yes` (hooks, tmux, starship, shell, app).
brew "larrykoo711/tap/cc-moss"
